    },
    "卡带架上有 %lld 张自己导入的游戏（演示卡不算）。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡带架上有 %lld 张自己导入的游戏（演示卡不算）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are %lld games of your own on the shelf (the demo card does not count). "
          }
        }
      }
    },
    "铁皮盒装满了。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铁皮盒装满了。"
          }
        },
