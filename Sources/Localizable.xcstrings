            "value": "在这里选的模式，下次开始游戏时用。游戏里按 HOME 也能换，马上生效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mode chosen here is used the next time a game starts. It can also be changed from HOME in a game, taking effect at once."
