        }
      }
    },
    "核心正在启动": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核心正在启动"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The core is starting"
          }
        }
      }
    },
    "App 包里没有核心二进制（azahar_libretro.framework）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 包里没有核心二进制（azahar_libretro.framework）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app bundle has no core binary (azahar_libretro.framework)"
          }
        }
      }
    },
    "Vulkan 不可用：%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vulkan 不可用：%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vulkan unavailable: %@"
          }
        }
      }
    },
    "Vulkan（%@）启动失败，改用软件渲染：%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vulkan（%@）启动失败，改用软件渲染：%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vulkan (%@) failed to start; using software rendering: %@"
          }
        }
      }
    },
    "软件渲染": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件渲染"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Software rendering"
          }
        }
      }
    },
    "存档位 %lld 要典藏卡带才能存（免费的是前 %lld 个）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存档位 %lld 要典藏卡带才能存（免费的是前 %lld 个）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving into slot %lld needs a Collector’s Cartridge (the first %lld are free)"
          }
        }
      }
    },
    "没有正在运行的游戏": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有正在运行的游戏"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No game is running"
          }
        }
      }
    },
    "这份进度由另一个版本的核心（%@）保存，当前是 %@；为避免出错没有读取。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份进度由另一个版本的核心（%@）保存，当前是 %@；为避免出错没有读取。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This save state was written by another core version (%@); this is %@. It was not loaded, to be safe."
          }
        }
      }
    },
    "倍速 %lld×": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倍速 %lld×"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed %lld×"
          }
        }
      }
    },
    "按键点屏 %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键点屏 %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key taps %@"
          }
        }
      }
    },
