        }
      }
    },
    "像素化、锐过头、偏蓝，色阶断": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像素化、锐过头、偏蓝，色阶断"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pixelated, over-sharpened, bluish, banded tones"
          }
        }
      }
    },
    "像隔着一层薄薄的光雾：发白发亮、颜色淡淡的、高光奶黄，软": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像隔着一层薄薄的光雾：发白发亮、颜色淡淡的、高光奶黄，软"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As if through a thin haze of light: pale and bright, washed colours, creamy highlights, soft"
          }
        }
      }
    },
    "偏蓝、通透、高光一片白，橙色日期": {
      "localizations": {
