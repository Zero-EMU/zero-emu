    "像掌机自带的相机拍的：偏软、边缘发亮，暗处有色斑": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像掌机自带的相机拍的：偏软、边缘发亮，暗处有色斑"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Like the handheld’s own camera: soft, bright edges, colour speckles in the dark"
          }
        }
      }
    },
    "偏暖、高光发晕、细颗粒，右下角橙色日期": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偏暖、高光发晕、细颗粒，右下角橙色日期"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm, glowing highlights, fine grain, orange date at the bottom right"
          }
        }
      }
    },
    "暖黄的底片色，黑不黑、白不白，颗粒": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
