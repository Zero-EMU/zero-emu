          "stringUnit": {
            "state": "translated",
            "value": "TV模式"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TV Mode"
          }
        }
      }
    },
    "在掌机上开启一个软件，画面会出现在这里": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在掌机上开启一个软件，画面会出现在这里"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a title on the handheld and its picture appears here"
          }
        }
      }
    },
    "%lld×": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld×"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld×"
          }
        }
      }
    },
    "倍速 %lld 倍": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倍速 %lld 倍"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed %lld×"
          }
        }
      }
    },
    "只靠点屏幕玩？按 HOME 打开「按键点屏」，A B X Y 就能代替手指": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只靠点屏幕玩？按 HOME 打开「按键点屏」，A B X Y 就能代替手指"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch-only game? Press HOME and turn on Key taps: A B X Y will tap the screen for you."
          }
        }
      }
    },
    "掌机触摸屏": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "掌机触摸屏"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handheld touch screen"
          }
        }
      }
    },
    "没找到脸，先按画面中间记下了。现在用内侧相机拍自己": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没找到脸，先按画面中间记下了。现在用内侧相机拍自己"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No face found; the middle of the picture was kept instead. Now take yourself with the inner camera"
          }
        }
      }
    },
    "记下了对方的脸。现在用内侧相机拍自己": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记下了对方的脸。现在用内侧相机拍自己"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other face is kept. Now take yourself with the inner camera"
          }
        }
      }
    },
    "相机被打断 · ": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机被打断 · "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera interrupted · "
          }
        }
      }
    },
    "录像不能涂画：选一张照片": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录像不能涂画：选一张照片"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos can’t be drawn on: pick a photo"
          }
        }
      }
    },
    "没能另存：画面没生成出来": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能另存：画面没生成出来"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save a copy: the picture was not produced"
          }
        }
      }
    },
    "没画上东西，没有另存": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没画上东西，没有另存"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was drawn; no copy saved"
          }
        }
      }
    },
    "「%@」只能拍照：先切回「拍照」": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」只能拍照：先切回「拍照」"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” takes photos only: switch back to Photo first"
          }
        }
      }
    },
    "合体时相机会自己换：先外侧，再内侧": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合体时相机会自己换：先外侧，再内侧"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge switches cameras by itself: outer first, then inner"
          }
        }
      }
    },
    "录像时不能换相机：先停下": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录像时不能换相机：先停下"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t switch cameras while recording: stop first"
          }
        }
      }
    },
    "相机停了 · ": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机停了 · "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera stopped · "
          }
        }
      }
    },
    "自拍定时取消了": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自拍定时取消了"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-timer cancelled"
          }
        }
      }
    },
    "相机没有启动起来。退出相机再打开试试；还不行就重启 iPhone。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机没有启动起来。退出相机再打开试试；还不行就重启 iPhone。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera did not start. Leave the camera and open it again; if that fails, restart the iPhone."
          }
        }
      }
    },
    "屏幕正在被录制或远程查看\n这时 iPhone 会清空相机画面，停掉就有了": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕正在被录制或远程查看\n这时 iPhone 会清空相机画面，停掉就有了"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen is being recorded or viewed remotely\nThe iPhone blanks the camera while that runs; stop it and the picture returns"
          }
        }
      }
    },
    "摄像头没有送来画面\n电脑在远程查看这台 iPhone 时会这样（右上角紫色图标，点它停掉）；不是的话重启 iPhone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头没有送来画面\n电脑在远程查看这台 iPhone 时会这样（右上角紫色图标，点它停掉）；不是的话重启 iPhone"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No picture from the camera\nThis happens while a computer is viewing this iPhone remotely (purple icon at the top right; tap it to stop). Otherwise restart the iPhone"
          }
        }
      }
    },
    "机型：原生（不加工）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机型：原生（不加工）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model: Native (no processing)"
