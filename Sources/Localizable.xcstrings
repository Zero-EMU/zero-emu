        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This run’s log and the last one that did not end cleanly; no name or birthday in it"
          }
        }
      }
    },
    "源码（GPLv3）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源码（GPLv3）"
          }
