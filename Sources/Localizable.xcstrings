      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给游戏画面加一层效果：原样、柔和、扫描线、LCD 网格、老电视"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
