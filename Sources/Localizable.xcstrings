        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenish, coarse grain, an orange light leak at the edge, date"
          }
        }
      }
    },
    "低清、偏灰、扫描线，角上 REC 和时间": {
      "localizations": {
        "zh-Hans": {
