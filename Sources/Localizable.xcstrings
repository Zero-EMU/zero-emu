        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除方式"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Style"
          }
        }
      }
    },
    "存档同步": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存档同步"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Sync"
          }
        }
      }
    },
    "备份": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup"
          }
        }
      }
    },
    "卡带证": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡带证"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartridge Pass"
          }
        }
      }
    },
    "开箱": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开箱"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unboxing"
          }
        }
      }
    },
    "设一个 4 位密码，就能限制 3D 影像、导入软件、删除软件和数据。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设一个 4 位密码，就能限制 3D 影像、导入软件、删除软件和数据。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a 4-digit PIN to restrict 3D images, importing software, and deleting software and data."
          }
        }
      }
    },
    "查看和删除游戏库里的软件、即时存档、继续进度，看主机存储用了多少。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看和删除游戏库里的软件、即时存档、继续进度，看主机存储用了多少。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See and delete the software in the library, save states and resume points, and how much system storage is used."
          }
        }
      }
    },
    "接电视：AirPlay 屏幕镜像，或转接线。在电视上玩，到主菜单的「游玩模式」选 TV模式，电视也在那里选。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接电视：AirPlay 屏幕镜像，或转接线。在电视上玩，到主菜单的「游玩模式」选 TV模式，电视也在那里选。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a TV: AirPlay screen mirroring, or an adapter. To play on the TV, pick TV Mode under Play Modes on the HOME Menu; the TV set is chosen there too."
          }
        }
      }
    },
    "每个游戏有好几个存档位。「保存进度」存进选中的那一个，「读取进度」读的也是它；换一个存档位，原来那个里的进度还在。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个游戏有好几个存档位。「保存进度」存进选中的那一个，「读取进度」读的也是它；换一个存档位，原来那个里的进度还在。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each game has several save slots. Save state saves into the chosen one and Load state loads from it; switch slots and the previous one keeps its state."
          }
        }
      }
    },
    "铜、银、金三张卡带，各放各的动画；有任何一张，就有全部机身配色、相机的全部机型、不限个数的存档位、存档同步、TV模式和倍速。月付、年付，或者一次买断；买过的也在这里恢复。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铜、银、金三张卡带，各放各的动画；有任何一张，就有全部机身配色、相机的全部机型、不限个数的存档位、存档同步、TV模式和倍速。月付、年付，或者一次买断；买过的也在这里恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three cartridges — bronze, silver and gold — each with films of its own; any one of them brings every shell colour, every camera model, any number of save slots, Save Sync, TV Mode and Speed. Monthly, yearly, or a one-time purchase; earlier purchases are restored here too."
          }
        }
      }
    },
    "用户信息、日期和时间、手柄、语言、声音、麦克风、触摸屏、摇杆、画面滤镜、3D、省电、亮度、画面渲染、震动、关于本机。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户信息、日期和时间、手柄、语言、声音、麦克风、触摸屏、摇杆、画面滤镜、3D、省电、亮度、画面渲染、震动、关于本机。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile, date & time, controller, language, sound, microphone, touch screen, stick, screen filter, 3D, power saving, brightness, rendering, haptics, about."
          }
        }
      }
    },
    "接电视：控制中心 ›「屏幕镜像」。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接电视：控制中心 ›「屏幕镜像」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Connect a TV: Control Centre › Screen Mirroring."
          }
        }
      }
    },
    "TV模式是典藏卡带的。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TV模式是典藏卡带的。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " TV Mode comes with a Collector’s Cartridge."
          }
        }
      }
    },
    "屏幕边缘参考线": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕边缘参考线"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen edge guides"
          }
        }
      }
    },
    "掌机模式下在两块屏的边缘画参考线，看掌机和 iPhone 的折痕、圆角对得准不准。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "掌机模式下在两块屏的边缘画参考线，看掌机和 iPhone 的折痕、圆角对得准不准。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In handheld mode, draw guides along the edges of both screens to check how the handheld lines up with the iPhone’s crease and corners."
          }
        }
      }
    },
    "没有折痕的 iPhone 上，假装的折痕在屏幕高度的哪里。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有折痕的 iPhone 上，假装的折痕在屏幕高度的哪里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On an iPhone without a crease, where along the screen’s height the pretend crease sits."
          }
        }
      }
    },
    "假装的折痕上下各空出多少。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "假装的折痕上下各空出多少。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much is left clear above and below the pretend crease."
          }
        }
      }
    },
    "电视上的布局": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电视上的布局"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout on the TV"
          }
        }
      }
    },
    "现代电视上两块屏怎么摆：上下两屏、左右并排，或只显示上屏。（旧电视里只放上屏，下屏在 iPhone 上。）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现代电视上两块屏怎么摆：上下两屏、左右并排，或只显示上屏。（旧电视里只放上屏，下屏在 iPhone 上。）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the two screens sit on a modern TV: stacked, side by side, or upper screen only. (Old TVs show the upper screen only; the lower one is on the iPhone.)"
          }
        }
      }
    },
    "TV模式在电视上画哪台电视：七台旧电视（游戏的上屏装在它的屏幕里），或者现代电视（不画外壳，画面铺满）。没接电视也能先选好。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TV模式在电视上画哪台电视：七台旧电视（游戏的上屏装在它的屏幕里），或者现代电视（不画外壳，画面铺满）。没接电视也能先选好。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which TV set TV Mode draws on the TV: seven old sets (the game’s upper screen inside their screen) or a modern TV (no casing, the picture fills it). It can be chosen before a TV is connected."
          }
        }
      }
    },
    "画面": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture"
          }
        }
      }
    },
    "当年的画面：显像管的扫描线、早期液晶的发虚，像那时候看到的；最好的画面：像素清楚、颜色准，还是装在那台电视里。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当年的画面：显像管的扫描线、早期液晶的发虚，像那时候看到的；最好的画面：像素清楚、颜色准，还是装在那台电视里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Period picture: the CRT’s scanlines, the early LCD’s softness, as it looked back then; best picture: crisp pixels, accurate colour, still inside that TV."
          }
        }
      }
    },
    "看合上盖子时的外屏；掀开就回来。（没有铰链的 iPhone）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看合上盖子时的外屏；掀开就回来。（没有铰链的 iPhone）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the cover screen as when the lid is closed; lift it to come back. (iPhones without a hinge)"
          }
        }
      }
    },
    "用户名、生日、国家/地区，和主机区域。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户名、生日、国家/地区，和主机区域。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User name, birthday, country/region, and the system region."
          }
        }
      }
    },
    "主机的时间跟着这台 iPhone。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机的时间跟着这台 iPhone。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The handheld’s clock follows this iPhone."
          }
        }
      }
    },
    "点三个目标校正触摸位置，再在空白处试一试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点三个目标校正触摸位置，再在空白处试一试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap three targets to calibrate touch, then try it in the blank area."
          }
        }
      }
    },
    "看摇杆推到了哪里，调中间的死区。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看摇杆推到了哪里，调中间的死区。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See where the stick is pushed and set the dead zone in the middle."
          }
        }
      }
    },
    "立体声、单声道或环绕声；静音模式时出不出声，别的 App 放音乐时怎么办；也看耳机有没有接上。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立体声、单声道或环绕声；静音模式时出不出声，别的 App 放音乐时怎么办；也看耳机有没有接上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stereo, mono or surround; whether sound plays in silent mode and what happens when another app plays music; also shows whether headphones are connected."
          }
        }
      }
    },
    "静音模式时也出声": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静音模式时也出声"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound in silent mode"
          }
        }
      }
    },
    "开着（默认）：iPhone 拨到静音，游戏照样出声，像掌机一样只听 VOL 滑块。关掉：跟着 iPhone 的静音走。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开着（默认）：iPhone 拨到静音，游戏照样出声，像掌机一样只听 VOL 滑块。关掉：跟着 iPhone 的静音走。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On (default): with the iPhone switched to silent, games still play — like a handheld, only the VOL slider counts. Off: follows the iPhone’s silent switch."
          }
        }
      }
    },
    "别的 App 在放音乐时": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别的 App 在放音乐时"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When another app plays music"
          }
        }
      }
    },
    "一起放：游戏和音乐混在一起。把音乐停掉：开始玩游戏时音乐停下，关掉游戏后它可以接着放。游戏不出声：音乐在放时游戏不出声。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一起放：游戏和音乐混在一起。把音乐停掉：开始玩游戏时音乐停下，关掉游戏后它可以接着放。游戏不出声：音乐在放时游戏不出声。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play together: the game mixes with the music. Stop the music: the music stops when a game starts and may carry on after it closes. Game stays silent: the game is silent while music plays."
          }
        }
      }
    },
    "对着 iPhone 吹气（或者按住掌机上的 MIC），看主机收到的声音。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对着 iPhone 吹气（或者按住掌机上的 MIC），看主机收到的声音。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blow on the iPhone (or hold the handheld’s MIC) and see what the handheld hears."
          }
        }
      }
    },
    "推 3D 滑块，看上屏的立体测试图。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推 3D 滑块，看上屏的立体测试图。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push the 3D slider and look at the stereo test picture on the upper screen."
          }
        }
      }
    },
    "画面亮度最高 75%，游戏用复古 1× 分辨率。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面亮度最高 75%，游戏用复古 1× 分辨率。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightness capped at 75%, games at retro 1× resolution."
          }
        }
      }
    },
    "两块屏的亮度，五档。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两块屏的亮度，五档。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightness of both screens, five levels."
          }
        }
      }
    },
    "渲染器、内部分辨率、像素原尺寸显示。下次开启软件时生效。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "渲染器、内部分辨率、像素原尺寸显示。下次开启软件时生效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderer, internal resolution, pixel-exact display. Takes effect the next time software starts."
          }
        }
      }
    },
    "按键时 iPhone 震不震、震多重。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键时 iPhone 震不震、震多重。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the iPhone vibrates on button presses, and how hard."
          }
        }
      }
    },
    "版本、模拟核心、用户名、上次运行，开源许可。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本、模拟核心、用户名、上次运行，开源许可。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version, emulation core, user name, last run, open-source licences."
          }
        }
      }
    },
    "Zero EMU 的许可和声明。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero EMU 的许可和声明。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero EMU’s licences and notices."
          }
        }
      }
    },
    "Zero EMU 的版本和更新方式。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero EMU 的版本和更新方式。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero EMU’s version and how it updates."
          }
        }
      }
    },
    "删除主机里的所有数据和设置，回到第一次开机的样子。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除主机里的所有数据和设置，回到第一次开机的样子。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase all data and settings on the handheld, back to the first start."
          }
        }
      }
    },
    "给游戏画面加一层效果：原样、柔和、扫描线、LCD 网格、老电视。马上生效，电视上也一样。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给游戏画面加一层效果：原样、柔和、扫描线、LCD 网格、老电视。马上生效，电视上也一样。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An effect over the game’s picture: as is, soft, scanlines, LCD grid, old TV. Takes effect at once, on the TV too."
          }
        }
      }
    },
    "接上手柄时自动换到手柄模式；手柄上的键对应 3DS 的哪个键，可以改。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接上手柄时自动换到手柄模式；手柄上的键对应 3DS 的哪个键，可以改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to Controller mode when a controller connects; which controller key is which 3DS button can be changed."
          }
        }
      }
    },
    "调试构建才有：方向诊断的开关。正式版没有这一项。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调试构建才有：方向诊断的开关。正式版没有这一项。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug builds only: switches for orientation diagnostics. Not in the release."
          }
        }
      }
    },
    "接上手柄自动换模式": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接上手柄自动换模式"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch modes when a controller connects"
          }
        }
      }
    },
    "接上手柄时换到手柄模式（两块屏放大，按键交给手柄），拔掉就换回原来的模式。TV模式下不换。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接上手柄时换到手柄模式（两块屏放大，按键交给手柄），拔掉就换回原来的模式。TV模式下不换。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a controller connects, switch to Controller mode (both screens enlarged, buttons on the controller); unplugging switches back. Not in TV Mode."
          }
        }
      }
    },
    "按键布局": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键布局"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Button layout"
          }
        }
      }
    },
    "按位置：和 3DS 一样，右边的键是 A。按字母：Xbox 手柄上印着 A 的键就是 A。改了某个键就是自定义。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按位置：和 3DS 一样，右边的键是 A。按字母：Xbox 手柄上印着 A 的键就是 A。改了某个键就是自定义。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By position: as on the 3DS, the right-hand key is A. By letter: the key printed A on an Xbox controller is A. Change any key and it becomes Custom."
          }
        }
      }
    },
    "恢复默认": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复默认"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore defaults"
          }
        }
      }
    },
    "按键布局回到按位置（和 3DS 一样）。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键布局回到按位置（和 3DS 一样）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The button layout goes back to by position (as on the 3DS)."
          }
        }
      }
    },
    "游戏库里的每个软件：大小、存档，和移除。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏库里的每个软件：大小、存档，和移除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each title in the library: size, saves, and removal."
          }
        }
      }
    },
    "主菜单里「保存进度」存下的档，和离开时自动存的继续进度。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主菜单里「保存进度」存下的档，和离开时自动存的继续进度。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "States saved with Save state in the HOME Menu, and the resume points saved automatically on leaving."
          }
        }
      }
    },
    "游戏副本、即时存档、主机存储各占多少；主机存储在「文件」App 里。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏副本、即时存档、主机存储各占多少；主机存储在「文件」App 里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much the game copies, save states and system storage take; system storage is in the Files app."
          }
        }
      }
    },
    "把游戏存档和即时存档同步到 iCloud 云盘里的一个文件夹（或 App 自己的 iCloud 空间），换一台设备接着玩。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把游戏存档和即时存档同步到 iCloud 云盘里的一个文件夹（或 App 自己的 iCloud 空间），换一台设备接着玩。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync game saves and save states to a folder in iCloud Drive (or the app’s own iCloud space) and carry on on another device."
          }
        }
      }
    },
    "把游戏存档和即时存档导出成一个 zip 留一份，或从导出过的备份放回来；不用 iCloud。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把游戏存档和即时存档导出成一个 zip 留一份，或从导出过的备份放回来；不用 iCloud。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export game saves and save states as one zip to keep, or bring them back from a backup — no iCloud needed."
          }
        }
      }
    },
    "存档同步是典藏卡带的功能。备份（把存档导出成一个 zip）不用典藏卡带。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存档同步是典藏卡带的功能。备份（把存档导出成一个 zip）不用典藏卡带。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Sync is a Collector’s Cartridge feature. Backup (exporting the saves as one zip) doesn’t need one."
          }
        }
      }
    },
    "开着时：打开 Zero EMU、关掉游戏、切到后台时各同步一次。游戏开着时不同步。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开着时：打开 Zero EMU、关掉游戏、切到后台时各同步一次。游戏开着时不同步。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on: syncs when Zero EMU opens, when a game closes, and when the app goes to the background. Not while a game is running."
          }
        }
      }
    },
    "文件夹": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder"
          }
        }
      }
    },
    "在「文件」里选一个文件夹，最好在 iCloud 云盘里；Zero EMU 在里面建一个「Zero EMU Saves」（以前的「Zero EMU 存档」「FoldArc 存档」会改成这个名字）。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「文件」里选一个文件夹，最好在 iCloud 云盘里；Zero EMU 在里面建一个「Zero EMU Saves」（以前的「Zero EMU 存档」「FoldArc 存档」会改成这个名字）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder in Files, ideally in iCloud Drive; Zero EMU makes a “Zero EMU Saves” folder inside it (an older “Zero EMU 存档” or “FoldArc 存档” is renamed)."
          }
        }
      }
    },
    "App 自己的 iCloud 空间": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 自己的 iCloud 空间"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app’s own iCloud space"
          }
        }
      }
    },
    "不用选文件夹，存档放在 Zero EMU 自己的 iCloud 空间里。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不用选文件夹，存档放在 Zero EMU 自己的 iCloud 空间里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No folder to choose: saves go in Zero EMU’s own iCloud space."
          }
        }
      }
    },
    "存到哪之一：不用选文件夹，存档放在 Zero EMU 自己的 iCloud 空间里，同一个 Apple ID 的设备都能拿到；在「文件」里是 iCloud 云盘 › Zero EMU。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存到哪之一：不用选文件夹，存档放在 Zero EMU 自己的 iCloud 空间里，同一个 Apple ID 的设备都能拿到；在「文件」里是 iCloud 云盘 › Zero EMU。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place one: no folder to choose; saves go in Zero EMU’s own iCloud space, reachable from every device on the same Apple Account; in Files it is iCloud Drive › Zero EMU."
          }
        }
      }
    },
    "「文件」里的文件夹": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「文件」里的文件夹"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A folder in Files"
          }
        }
      }
    },
    "存到哪之二：你在「文件」里选的一个文件夹（选 iCloud 云盘里的就是 iCloud 同步），别的设备选同一个文件夹。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存到哪之二：你在「文件」里选的一个文件夹（选 iCloud 云盘里的就是 iCloud 同步），别的设备选同一个文件夹。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place two: a folder you choose in Files (one in iCloud Drive syncs through iCloud); choose the same folder on other devices."
          }
        }
      }
    },
    "现在同步": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在同步"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync now"
          }
        }
      }
    },
    "马上比一遍两边，改过的传过去。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "马上比一遍两边，改过的传过去。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare both sides now and send what changed."
          }
        }
      }
    },
    "修复同步": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修复同步"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repair sync"
          }
        }
      }
    },
    "不信上次的记录，两边每个文件按内容重新比一遍，缺的补上；什么都不删，两边不一样的旧的那份放进 Conflicts。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不信上次的记录，两边每个文件按内容重新比一遍，缺的补上；什么都不删，两边不一样的旧的那份放进 Conflicts。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore the last record and compare every file on both sides by content, filling in what is missing; nothing is deleted, and where the two differ the older copy goes into Conflicts."
          }
        }
      }
    },
    "同步这个游戏的存档": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步这个游戏的存档"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync this game’s saves"
          }
        }
      }
    },
    "关掉时，这个游戏的存档和即时存档只留在这台设备上，不传也不拿。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉时，这个游戏的存档和即时存档只留在这台设备上，不传也不拿。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, this game’s saves and save states stay on this device only — neither sent nor fetched."
          }
        }
      }
    },
    "数据文件夹 CoreTest 里的 Homebrew（开发用）：点一个直接在核心上开启，不用导入。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据文件夹 CoreTest 里的 Homebrew（开发用）：点一个直接在核心上开启，不用导入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew in the CoreTest data folder (for development): tap one to start it on the core without importing."
          }
        }
      }
    },
    "先设密码，再选一个秘密问题，最后选要限制什么。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先设密码，再选一个秘密问题，最后选要限制什么。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a PIN first, then choose a secret question, then choose what to restrict."
          }
        }
      }
    },
    "3D 影像": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3D 影像"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3D images"
          }
        }
      }
    },
    "开着时，3D 滑块推不上去，画面一直是 2D。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开着时，3D 滑块推不上去，画面一直是 2D。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the 3D slider won’t go up; the picture stays 2D."
          }
        }
      }
    },
    "导入软件": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入软件"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Importing software"
          }
        }
      }
    },
    "开着时，主菜单里的「导入」不能用。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开着时，主菜单里的「导入」不能用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, Import on the HOME Menu is disabled."
          }
        }
      }
    },
    "删除软件和数据": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除软件和数据"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting software and data"
          }
        }
      }
    },
    "开着时，不能移除软件、删除存档，也不能格式化主机。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开着时，不能移除软件、删除存档，也不能格式化主机。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, software can’t be removed, saves can’t be deleted, and the system can’t be formatted."
          }
        }
      }
    },
    "更改密码": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改密码"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change PIN"
          }
        }
      }
    },
    "换一个 4 位密码。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换一个 4 位密码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a different 4-digit PIN."
          }
        }
      }
    },
    "清除家长控制": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除家长控制"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear Parental Controls"
          }
        }
      }
    },
    "去掉密码和所有限制。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉密码和所有限制。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the PIN and every restriction."
          }
        }
      }
    },
    "回答设置时选的秘密问题，答对就清除家长控制。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答设置时选的秘密问题，答对就清除家长控制。"
