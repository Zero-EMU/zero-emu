    "不画旧电视": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不画旧电视"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No old TV drawn"
          }
        }
      }
    },
    "黑色前框、两边条形音箱孔、底下一条银色面板和圆形电源键：那几年客厅里最常见的平面直角彩电。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑色前框、两边条形音箱孔、底下一条银色面板和圆形电源键：那几年客厅里最常见的平面直角彩电。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Black front, speaker slots down both sides, a silver strip and a round power button below: the flat-screen CRT most living rooms had in those years."
          }
        }
      }
    },
    "银灰外框，下沿微微弯出来，两边整片圆孔音箱，按键在右下角。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银灰外框，下沿微微弯出来，两边整片圆孔音箱，按键在右下角。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Silver-grey frame, a slight curve along the bottom, perforated speakers on both sides, buttons at the bottom right."
          }
        }
      }
    },
    "顶上一个小台子插着卡带，电源、重置和一颗灯；屏幕角更圆、玻璃更鼓。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶上一个小台子插着卡带，电源、重置和一颗灯；屏幕角更圆、玻璃更鼓。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little deck on top with a cartridge, power, reset and one light; rounder corners, more bulge in the glass."
          }
        }
      }
    },
    "屏幕下面一个放录像带的口、一个放光碟的口，蓝色的小时间显示。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕下面一个放录像带的口、一个放光碟的口，蓝色的小时间显示。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tape slot and a disc slot under the screen, a small blue clock."
          }
        }
      }
    },
    "圆滚滚的薄荷绿外壳、提手、两个大旋钮、圆形喇叭。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆滚滚的薄荷绿外壳、提手、两个大旋钮、圆形喇叭。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A round mint-green shell, a handle, two big dials, a round speaker."
          }
        }
      }
    },
    "早期液晶：4:3 的屏、细银框、下面一条长喇叭、圆底座。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "早期液晶：4:3 的屏、细银框、下面一条长喇叭、圆底座。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Early LCD: a 4:3 screen, thin silver frame, a long speaker bar below, round base."
          }
        }
      }
    },
    "亮黑边框、底边一道透明条、小底座，16:9。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亮黑边框、底边一道透明条、小底座，16:9。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glossy black bezel, a clear strip along the bottom, small stand, 16:9."
          }
        }
      }
    },
    "画面直接铺满电视，按最好的画面显示；两块屏怎么摆，在「电视上的布局」里选。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面直接铺满电视，按最好的画面显示；两块屏怎么摆，在「电视上的布局」里选。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The picture fills the TV at the best quality; how the two screens are arranged is chosen under “Layout on the TV”."
          }
        }
      }
    },
    "当年的画面": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当年的画面"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Period picture"
          }
        }
      }
    },
    "最好的画面": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最好的画面"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best picture"
          }
        }
      }
    },
    "显像管：一行一行的扫描线，亮的地方晕开一点，玻璃四角暗。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显像管：一行一行的扫描线，亮的地方晕开一点，玻璃四角暗。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CRT: scanlines row by row, bright parts bloom a little, the glass darkens at the corners."
          }
        }
      }
    },
    "早期液晶：放大以后发虚，黑色发灰，四角漏一点光。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "早期液晶：放大以后发虚，黑色发灰，四角漏一点光。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Early LCD: soft when enlarged, greyish blacks, a little light leaking at the corners."
          }
        }
      }
    },
    "像素方方正正、边缘锐利、颜色准；还是装在这台电视里。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
