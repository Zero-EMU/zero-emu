          "stringUnit": {
            "state": "translated",
            "value": "按键原样交给正在运行的软件，具体用途以游戏为准。屏幕小的时候可以在 HOME 里换成「手柄模式」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The buttons go straight to the running software; what they do is up to the game. On a small screen, switch to Controller mode from HOME."
          }
        }
