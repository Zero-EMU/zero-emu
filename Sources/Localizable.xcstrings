        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm yellow negative tones, blacks not black, whites not white, grain"
          }
        }
      }
    },
    "一张奶白相纸，画面柔、偏粉，四边等宽": {
      "localizations": {
        "zh-Hans": {
