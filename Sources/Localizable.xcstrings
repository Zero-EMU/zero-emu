        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled"
          }
        }
      }
    },
    "%@ %@ · %lld×%lld · %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ · %lld×%lld · %@"
