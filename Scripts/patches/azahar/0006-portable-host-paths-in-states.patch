diff --git a/src/common/file_util.cpp b/src/common/file_util.cpp
index 3168a26..e2ce9ed 100644
--- a/src/common/file_util.cpp
+++ b/src/common/file_util.cpp
@@ -1055,12 +1055,40 @@ bool StringReplace(std::string& haystack, const std::string& a, const std::strin
     return true;
 }
 
+// Modified by FoldArc on 2026-10-28: a loaded path that still names another
+// install's user directory (states saved before the archives stored their paths
+// as FileUtil::Path kept raw host paths; on iOS the folder holding the user
+// directory moves with app updates and reinstalls, and FoldArc moved it into
+// Documents) is moved onto the current user directory. Only paths that continue
+// below an "Azahar" user directory with one of its own folders are touched; the
+// first such directory from the left is the user directory (a folder of that
+// name inside the SD card comes after it).
+static std::string RebaseForeignUserPath(const std::string& path) {
+    const std::string& user = GetUserPath(UserPath::UserDir);
+    if (path.empty() || user.empty() || path.starts_with(user)) {
+        return path;
+    }
+    static const std::string marker = "/Azahar/";
+    for (auto pos = path.find(marker); pos != std::string::npos; pos = path.find(marker, pos + 1)) {
+        const std::string_view rest = std::string_view(path).substr(pos + marker.size());
+        for (const std::string_view folder : {"sdmc", "nand", "sysdata", "load"}) {
+            if (rest.starts_with(folder) && (rest.size() == folder.size() || rest[folder.size()] == '/')) {
+                return user + std::string(rest);
+            }
+        }
+    }
+    return path;
+}
+
 std::string SerializePath(const std::string& input, bool is_saving) {
     auto result = input;
     StringReplace(result, "%CITRA_ROM_FILE%", g_currentRomPath, is_saving);
     StringReplace(result, "%CITRA_USER_DIR%", GetUserPath(UserPath::UserDir), is_saving);
     StringReplace(result, "%CITRA_USER_SDMC%", GetUserPath(UserPath::SDMCDir), is_saving);
     StringReplace(result, "%CITRA_USER_NAND%", GetUserPath(UserPath::NANDDir), is_saving);
+    if (!is_saving) {
+        result = RebaseForeignUserPath(result);
+    }
     return result;
 }
 
